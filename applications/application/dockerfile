FROM node:22-alpine AS web
WORKDIR /src/web
COPY web/package.json web/yarn.lock ./
RUN yarn install --frozen-lockfile
COPY web/ ./
RUN yarn run build


FROM golang:1-alpine AS go

ARG VERSION_TYPE
ENV VERSION_TYPE=$VERSION_TYPE

ARG SEMVER
ENV SEMVER=$SEMVER

ARG VERSION_NAME
ENV VERSION_NAME=$VERSION_NAME

RUN apk add --no-cache git
WORKDIR /fathom
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /src/web/dist ./web/dist
RUN CGO_ENABLED=0 go build -ldflags="-w -s -X github.com/egot3/fathom/version.Type=${VERSION_TYPE} -X github.com/egot3/fathom/version.SemVer=${SEMVER} -X github.com/egot3/fathom/version.Name=${VERSION_NAME}" -o /out/fathom .


FROM scratch
ARG PORT
ENV PORT=$PORT
COPY --from=go /out/fathom /fathom
EXPOSE ${PORT}
ENTRYPOINT ["/fathom"]
